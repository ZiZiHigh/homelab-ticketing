# Copy this file to .env and adjust the values for this host.
# Do not put passwords or tokens in this file. They live in compose/secrets/.
COMPOSE_PROJECT_NAME=ticket-system
TZ=Europe/Prague

DB_NAME=osticket
DB_USER=osticket
DB_PREFIX=ost_

INSTALL_NAME=Homelab Helpdesk
INSTALL_EMAIL=helpdesk@home.arpa
INSTALL_URL=http://tickets.home.arpa
INSTALL_LANG=en_US
ADMIN_FIRSTNAME=Homelab
ADMIN_LASTNAME=Admin
ADMIN_EMAIL=admin@home.arpa
# osTicket rejects the exact names admin, admins, username and osticket.
ADMIN_USER=homelab-admin

PHP_MEMORY_LIMIT=160M
PHP_UPLOAD_MAX_SIZE=25M
TRUSTED_PROXIES=172.20.0.0/16
REALIP_HEADER=X-Real-IP
